{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 950,
  "height": 480,
  "description": "Comparison between Federico's grades and the group's average (Alice, Marco, Sara)",
  "data": {
    "values": [
      {"esame":"Fondamenti di Informatica","data":"2022-02-15","Federico":"28","Alice":"27","Marco":"29","Sara":"30","cfu":6},
      {"esame":"Analisi Matematica 1","data":"2022-03-10","Federico":"19","Alice":"24","Marco":"26","Sara":"25","cfu":9},
      {"esame":"Fisica 1","data":"2022-05-05","Federico":"27","Alice":"30","Marco":"24","Sara":"28","cfu":8},
      {"esame":"Programmazione 1","data":"2022-07-01","Federico":"25","Alice":"29","Marco":"30L","Sara":"28","cfu":9},
      {"esame":"Architettura degli Elaboratori","data":"2022-09-12","Federico":"26","Alice":"28","Marco":"29","Sara":"27","cfu":6},
      {"esame":"Basi di Dati","data":"2022-11-20","Federico":"30L","Alice":"18","Marco":"25","Sara":"28","cfu":6},
      {"esame":"Sistemi Operativi","data":"2023-01-18","Federico":"26","Alice":"27","Marco":"25","Sara":"28","cfu":8},
      {"esame":"Reti di Calcolatori","data":"2023-03-07","Federico":"28","Alice":"30L","Marco":"24","Sara":"29","cfu":6},
      {"esame":"Fondamenti di Automatica 1","data":"2023-05-15","Federico":"22","Alice":"29","Marco":"30","Sara":"25","cfu":8},
      {"esame":"Ingegneria del Software","data":"2023-07-30","Federico":"29","Alice":"28","Marco":"27","Sara":"22","cfu":6},
      {"esame":"Programmazione 2","data":"2023-09-25","Federico":"27","Alice":"26","Marco":"30","Sara":"28","cfu":9},
      {"esame":"Algoritmi e Strutture Dati","data":"2023-11-10","Federico":"30L","Alice":"26","Marco":"24","Sara":"28","cfu":9},
      {"esame":"Calcolo Numerico","data":"2024-01-22","Federico":"24","Alice":"30","Marco":"27","Sara":"26","cfu":6},
      {"esame":"Laboratorio di Informatica","data":"2024-03-18","Federico":"30","Alice":"27","Marco":"26","Sara":"25","cfu":6},
      {"esame":"Linguaggi e Compilatori","data":"2024-05-14","Federico":"28","Alice":"27","Marco":"29","Sara":"30","cfu":8},
      {"esame":"Fondamenti di Automatica 2","data":"2024-07-09","Federico":"27","Alice":"28","Marco":"26","Sara":"22","cfu":6},
      {"esame":"Fisica 2","data":"2024-09-20","Federico":"24","Alice":"26","Marco":"29","Sara":"30","cfu":6},
      {"esame":"Analisi Matematica 2","data":"2024-11-05","Federico":"18","Alice":"25","Marco":"24","Sara":"30L","cfu":9},
      {"esame":"Sistemi Distribuiti","data":"2025-01-12","Federico":"20","Alice":"28","Marco":"27","Sara":"29","cfu":6}
    ]
  },
  "transform": [
    {"fold": ["Federico", "Alice", "Marco", "Sara"], "as": ["studente", "voto"]},
    {"calculate": "indexof(toString(datum.voto),'L')>=0 ? 30 : toNumber(datum.voto)", "as": "grade"}
  ],
  "title": {"text": "Federico vs Group Average (Alice, Marco, Sara)", "anchor": "start"},

  "encoding": {
    "color": {
      "scale": {
        "domain": ["Federico", "Group Average (A, M, S)"],
        "range": ["#f9a828", "#1B3B6F"]
      }
    },
    "strokeDash": {      "scale": {
        "domain": ["Federico", "Group Average (A, M, S)"],
        "range": [[1, 0], [5, 5]]
      }
    }
  },

  "layer": [
    {
      "transform": [{"filter": "datum.studente == 'Federico'"}],
      "mark": {"type": "line", "strokeWidth": 3},
      "encoding": {
        "x": {"field": "data", "type": "temporal", "title": "Exam Date", "axis": {"format": "%Y-%m-%d", "labelAngle": -40}},
        "y": {"field": "grade", "type": "quantitative", "title": "Grade"},
        "color": {"datum": "Federico"},
        "strokeDash": {"datum": "Federico"},
        "tooltip": [
          {"field": "data", "type": "temporal", "title": "Date"},
          {"field": "grade", "type": "quantitative", "title": "Federico"}
        ]
      }
    },
    {
      "transform": [
        {"filter": "datum.studente != 'Federico'"},
        {"aggregate": [{"op": "mean", "field": "grade", "as": "group_avg"}], "groupby": ["data"]}
      ],
      "mark": {"type": "line", "strokeWidth": 3},
      "encoding": {
        "x": {"field": "data", "type": "temporal"},
        "y": {"field": "group_avg", "type": "quantitative"},
        "color": {"datum": "Group Average (A, M, S)"},
        "strokeDash": {"datum": "Group Average (A, M, S)"},
        "tooltip": [
          {"field": "data", "type": "temporal", "title": "Date"},
          {"field": "group_avg", "type": "quantitative", "title": "Group Average (no Federico)", "format": ".2f"}
        ]
      }
    }
  ],
  "config": {
    "axis": {"labelFontSize": 12, "titleFontSize": 13},
    "title": {"fontSize": 16},
    "legend": {
      "orient": "right",
      "titleFontSize": 13,
      "labelFontSize": 12
    }
  }
}