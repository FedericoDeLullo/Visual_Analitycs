  "transform":[
    {"fold":["Federico","Alice","Marco","Sara"],"as":["studente","voto"]},
    {"calculate":"indexof(toString(datum.voto),'L')>=0 ? 30 : toNumber(datum.voto)","as":"grade"},
    {"calculate":"indexof(toString(datum.voto),'L')>=0","as":"honors"},
    {"calculate":"toNumber(datum.cfu)","as":"cfu_n"}
  ],
  "title":{"text":"Group's Temporal Trend (4 students)","anchor":"start"},
  "layer":[
    {
      "mark":{"type":"line","interpolate":"linear","strokeWidth":3,"opacity":0.85},
      "encoding":{
        "x":{"field":"data","type":"temporal","title":"Exam Date","axis":{"format":"%Y-%m-%d","labelAngle":-40}},
        "y":{"field":"grade","type":"quantitative","title":"Grade"},
        "color":{
          "field":"studente",
          "type":"nominal",
          "title":"Student",
          "scale":{
            "domain":["Federico","Alice","Marco","Sara"],
            "range":["#f9a828","#1B3B6F","#D62728","#008B45"]
          }
        },
        "detail":{"field":"studente"}
      }
    },
    {
      "mark":{"type":"point","filled":true,"stroke":"white","strokeWidth":1.5},
      "encoding":{
        "x":{"field":"data","type":"temporal"},
        "y":{"field":"grade","type":"quantitative"},
        "color":{
          "field":"studente",
          "type":"nominal",
          "scale":{
            "domain":["Federico","Alice","Marco","Sara"],
            "range":["#f9a828","#1B3B6F","#D62728","#008B45"]
          },
          "legend":{"title":"Student"}
        },
        "size":{"field":"cfu_n","type":"quantitative","scale":{"range":[40,200]},"title":"CFU"},
        "shape":{"field":"honors","type":"nominal","scale":{"domain":[false,true],"range":["circle","triangle"]},"title":"30L"},
        "tooltip":[
          {"field":"studente","type":"nominal","title":"Studente"},
          {"field":"esame","type":"nominal","title":"Exam"},
          {"field":"data","type":"temporal","title":"Date","format":"%Y-%m-%d"},
          {"field":"voto","type":"nominal","title":"Original Grade"},
          {"field":"grade","type":"quantitative","title":"Normalized Grade"},
          {"field":"cfu_n","type":"quantitative","title":"CFU"}
        ]
      }
    }
  ],
  "config":{"axis":{"labelFontSize":12,"titleFontSize":13},"title":{"fontSize":16},"legend":{"labelFontSize":12}}
}
