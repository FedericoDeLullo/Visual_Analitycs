{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 900,
  "height": 420,
  "description": "Bar chart: Federico's grades. 30L highlighted.",
  "data": {
    "values": [
      {"esame":"Fondamenti di Informatica","data":"2022-02-15","voto":"28","cfu":6},
      {"esame":"Analisi Matematica 1","data":"2022-03-10","voto":"19","cfu":9},
      {"esame":"Fisica 1","data":"2022-05-05","voto":"27","cfu":8},
      {"esame":"Programmazione 1","data":"2022-07-01","voto":"25","cfu":9},
      {"esame":"Architettura degli Elaboratori","data":"2022-09-12","voto":"26","cfu":6},
      {"esame":"Basi di Dati","data":"2022-11-20","voto":"30L","cfu":6},
      {"esame":"Sistemi Operativi","data":"2023-01-18","voto":"26","cfu":8},
      {"esame":"Reti di Calcolatori","data":"2023-03-07","voto":"28","cfu":6},
      {"esame":"Fondamenti di Automatica 1","data":"2023-05-15","voto":"22","cfu":8},
      {"esame":"Ingegneria del Software","data":"2023-07-30","voto":"29","cfu":6},
      {"esame":"Programmazione 2","data":"2023-09-25","voto":"27","cfu":9},
      {"esame":"Algoritmi e Strutture Dati","data":"2023-11-10","voto":"30L","cfu":9},
      {"esame":"Calcolo Numerico","data":"2024-01-22","voto":"24","cfu":6},
      {"esame":"Laboratorio di Informatica","data":"2024-03-18","voto":"30","cfu":6},
      {"esame":"Linguaggi e Compilatori","data":"2024-05-14","voto":"28","cfu":8},
      {"esame":"Fondamenti di Automatica 2","data":"2024-07-09","voto":"27","cfu":6},
      {"esame":"Fisica 2","data":"2024-09-20","voto":"24","cfu":6},
      {"esame":"Analisi Matematica 2","data":"2024-11-05","voto":"18","cfu":9},
      {"esame":"Sistemi Distribuiti","data":"2025-01-12","voto":"20","cfu":6}
    ]
  },
  "transform": [
    {"calculate": "indexof(toString(datum.voto),'L') >= 0 ? 30 : toNumber(toString(datum.voto))","as":"voto_num"},
    {"calculate": "indexof(toString(datum.voto),'L') >= 0 ? '30L' : toString(datum.voto)","as":"voto_display"}
  ],
  "title": {
    "text":"Federico's grades (Exams Sorted Chronologically)",
    "subtitle":"30L highlighted.",
    "anchor":"start"
  },
  "layer": [
    {
      "mark":{"type":"bar","cornerRadiusTopLeft":6,"cornerRadiusTopRight":6},
      "encoding": {
        "x":{"field":"esame","type":"ordinal","sort":{"field":"data","op":"min"},"axis":{"labelAngle":-40,"labelFontSize":13,"title":"Exam"}},
        "y":{"field":"voto_num","type":"quantitative","axis":{"title":"Grade","labelFontSize":13}},
        "color":{"condition":{"test":"datum.voto_display==='30L'","value":"#f8da5b"},"value":"#247291"},
        "tooltip":[
          {"field":"esame","type":"nominal","title":"Esame"},
          {"field":"data","type":"temporal","title":"Data","format":"%Y-%m-%d"},
          {"field":"voto_display","type":"nominal","title":"Voto"},
          {"field":"cfu","type":"quantitative","title":"CFU"}
        ]
      }
    },
    {
      "mark":{"type":"rule","color":"black","strokeWidth":2,"strokeDash":[4,4]},
      "encoding": {
        "y":{"value":168},
        "tooltip":[{"value":"Passing grade = 18","title":"Minimum grade"}]
      }
    },
    {
      "mark":{"type":"text","font":"Helvetica","align":"left","baseline":"middle","dx":5,"dy":0,"color":"black","fontWeight":"bold","fontSize":16},
      "encoding": {
        "y":{"value":168},
        "x":{"value":-150},
        "text":{"value":"Minimum grade"}
      }
    }
  ],
  "config":{
    "axis":{"labelFontSize":12,"titleFontSize":14},
    "title":{"fontSize":16},
    "legend":{"labelFontSize":12}
  }
}
