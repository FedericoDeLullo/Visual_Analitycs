  "transform":[
    {"calculate":"indexof(toString(datum.voto),'L')>=0 ? 30 : toNumber(toString(datum.voto))","as":"grade"},
    {"calculate":"indexof(toString(datum.voto),'L')>=0","as":"honors"},
    {"calculate":"toNumber(datum.cfu)","as":"cfu_n"}
  ],
  "title":{"text":"Federico's Temporal Trend","subtitle":"Points sized by CFU; orange = 30L","anchor":"start"},
  "layer":[
    {
      "mark":{"type":"line","interpolate":"linear","strokeWidth":3,"color":"#247291"},
      "encoding":{
        "x":{
          "field":"data",
          "type":"temporal",
          "title":"Exam Date",
          "axis":{"labelAngle":-40,"format":"%Y-%m-%d","tickCount":19}
        },
        "y":{"field":"grade","type":"quantitative","title":"Grade","scale":{"domain":[18,30]}}
      }
    },
    {
      "mark":{"type":"point","filled":true,"stroke":"white","strokeWidth":1.5},
      "encoding":{
        "x":{"field":"data","type":"temporal"},
        "y":{"field":"grade","type":"quantitative"},
        "size":{"field":"cfu_n","type":"quantitative","scale":{"range":[60,220]},"title":"CFU"},
        "color":{"field":"honors","type":"nominal","scale":{"domain":[false,true],"range":["#4C78A8","#FF6F00"]},"title":"30L"},
        "tooltip":[
          {"field":"esame","type":"nominal","title":"Esame"},
          {"field":"data","type":"temporal","title":"Data","format":"%Y-%m-%d"},
          {"field":"grade","type":"quantitative","title":"Voto normalizzato"},
          {"field":"voto","type":"nominal","title":"Valore originale"},
          {"field":"cfu_n","type":"quantitative","title":"CFU"},
          {"field":"honors","type":"nominal","title":"30L"}
        ]
      }
    }
  ],
  "config":{"axis":{"labelFontSize":12,"titleFontSize":13},"title":{"fontSize":16},"legend":{"labelFontSize":12}}
}
